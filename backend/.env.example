# Copy this file to .env for local development
# DO NOT commit .env files to version control - they contain secrets
# Each environment variable must be configured before running the application

# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=AI Assistance Platform

# Database
# Format: postgresql+asyncpg://username:password@hostname:port/database
# For local development, adjust credentials as needed
DATABASE_URL=postgresql+asyncpg://ai_assistance:ai_assistance@localhost:5432/ai_assistance

# JWT auth
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Document ingestion
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Azure Configuration
# Get these values from Azure Portal > Subscription details
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_REGION=eastus

# OpenAI Configuration
# Get API key from https://platform.openai.com/account/api-keys
# Available models: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
